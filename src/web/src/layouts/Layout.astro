---
import { metadata } from "../content/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = metadata.title, description = metadata.description } = Astro.props;
---

<!doctype html>
<html lang={metadata.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(metadata.ogImage, metadata.url).href} />
    <meta property="og:url" content={metadata.url} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(metadata.ogImage, metadata.url).href} />

    <link rel="canonical" href={metadata.url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600&family=Oswald:wght@500;700&family=Permanent+Marker&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/reveal-on-scroll";
    </script>
  </body>
</html>
