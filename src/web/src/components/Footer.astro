---
import { footer } from "../content/site";
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">PÁNICO <span class="footer__amp">&</span> CÍA</p>
      <p class="footer__tagline">{footer.tagline}</p>
    </div>

    <nav class="footer__socials" aria-label="Redes sociales">
      {footer.socials.map((social) => (
        <a
          href={social.url}
          class="footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label}
        >
          {social.label}
        </a>
      ))}
    </nav>

    <p class="footer__copy">
      &copy; {new Date().getFullYear()} {footer.bandName}. Todos los derechos reservados.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 3rem 1.25rem;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .footer__amp {
    color: var(--color-red);
  }

  .footer__tagline {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .footer__socials {
    display: flex;
    gap: 1.5rem;
  }

  .footer__social-link {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 150ms ease;
  }

  .footer__social-link:hover {
    color: var(--color-red);
  }

  .footer__copy {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
</style>
