---
import { social } from "../content/site";
---

<section id="social" class="section" data-reveal>
  <div class="container social__inner">
    <p class="eyebrow">{social.eyebrow}</p>
    <h2 class="section-title">{social.title}</h2>
    <p class="section-lead">{social.lead}</p>

    <div class="social__links">
      {social.links.map((link) => (
        <a
          href={link.url}
          class="social__link card"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${link.label}: ${link.handle}`}
          data-reveal
        >
          <span class="social__label">{link.label}</span>
          <span class="social__handle">{link.handle}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .social__inner {
    text-align: center;
  }

  .social__inner .section-lead {
    margin-inline: auto;
  }

  .social__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .social__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 2.5rem;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .social__link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 rgb(255 48 69 / 0.25);
  }

  .social__label {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-red);
  }

  .social__handle {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
