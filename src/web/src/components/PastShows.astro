---
import { pastShows } from "../content/site";
---

<section id="past-shows" class="section" data-reveal>
  <div class="container">
    <p class="eyebrow">{pastShows.eyebrow}</p>
    <h2 class="section-title">{pastShows.title}</h2>
    <p class="section-lead">{pastShows.lead}</p>

    <ul class="past-shows__list">
      {pastShows.shows.map((show) => (
        <li class="past-shows__item card" data-reveal>
          <div class="past-shows__info">
            <span class="past-shows__venue">{show.venue}</span>
            <span class="past-shows__city">{show.city}</span>
          </div>
          <div class="past-shows__meta">
            <span class="past-shows__date">{show.date}</span>
            <span class="past-shows__note">{show.note}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .past-shows__list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .past-shows__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .past-shows__info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .past-shows__venue {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .past-shows__city {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .past-shows__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    text-align: right;
  }

  .past-shows__date {
    color: var(--color-red);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .past-shows__note {
    color: var(--color-muted);
    font-size: 0.8rem;
    font-style: italic;
  }
</style>
