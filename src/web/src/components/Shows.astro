---
import { shows } from "../content/site";

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + "T00:00:00");
  return date.toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<section id="shows" class="section" data-reveal>
  <div class="container">
    <p class="eyebrow">{shows.eyebrow}</p>
    <h2 class="section-title">{shows.title}</h2>

    {shows.shows.length > 0 ? (
      <ul class="shows__list">
        {shows.shows.map((show) => (
          <li class="shows__item card" data-reveal>
            <div class="shows__info">
              <time class="shows__date" datetime={show.date}>{formatDate(show.date)}</time>
              <span class="shows__venue">{show.venue}</span>
              <span class="shows__city">{show.city}</span>
            </div>
            {show.ticketUrl && (
              <a href={show.ticketUrl} class="button shows__ticket" target="_blank" rel="noopener noreferrer">
                Entradas
              </a>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="section-lead">{shows.emptyMessage}</p>
    )}
  </div>
</section>

<style>
  .shows__list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .shows__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }

  .shows__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .shows__date {
    color: var(--color-red);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .shows__venue {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .shows__city {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .shows__ticket {
    font-size: 0.85rem;
    padding: 0.6rem 1.2rem;
    min-height: 2.5rem;
  }
</style>
