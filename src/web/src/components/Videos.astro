---
import { videos } from "../content/site";
---

<section id="videos" class="section" data-reveal>
  <div class="container">
    <p class="eyebrow">{videos.eyebrow}</p>
    <h2 class="section-title">{videos.title}</h2>

    <div class="videos__grid">
      {videos.videos.map((video) => (
        <div class="videos__item" data-reveal>
          <div class="videos__embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
              title={video.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <p class="videos__title">{video.title}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .videos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .videos__item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .videos__embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .videos__embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .videos__title {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-muted);
  }
</style>
