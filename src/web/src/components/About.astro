---
import { about } from "../content/site";
---

<section id="about" class="section" data-reveal>
  <div class="container">
    <p class="eyebrow">{about.eyebrow}</p>
    <h2 class="section-title">{about.title}</h2>
    <p class="section-lead about__description">{about.description}</p>
  </div>
</section>

<style>
  .about__description {
    margin-top: 1.5rem;
  }
</style>
